# Copy into jitsi-docker/.env after cloning docker-jitsi-meet
# See README.md for full setup

PUBLIC_URL=https://meet.yourdomain.com
DOCKER_HOST_ADDRESS=YOUR_SERVER_IP

# Auth — disable for prototype, enable for production
ENABLE_AUTH=0
ENABLE_GUESTS=1

# Recording
ENABLE_RECORDING=1
JIBRI_RECORDING_DIR=/config/recordings
JIBRI_FINALIZE_RECORDING_SCRIPT_PATH=/config/finalize-recording.sh

# Performance tuning for music lessons (lower default resolution = less CPU)
# Applied via custom config in interfaceConfigOverwrite in the app
RESOLUTION=720
RESOLUTION_MIN=360
RESOLUTION_WIDTH=1280

# TLS (production)
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=meet.yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com
